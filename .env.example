# Discord webhook URLs for the epoch announcer (netlify/functions/announce-epoch).
# These are credentials -- set them in Netlify (Site configuration -> Environment
# variables), never in source. Create them in Discord: Channel settings ->
# Integrations -> Webhooks. If one ever leaks, delete it in Discord and create a new one.
DISCORD_WINNERS_WEBHOOK_URL=
DISCORD_DIVIDENDS_WEBHOOK_URL=
